# OS / editor
.DS_Store
*.swp

# Dependencies and environments
node_modules/
tools/tts/.venv/
__pycache__/
*.pyc
.env
.env.*

# Models
tools/tts-models/

# Rendered video and audio, anywhere
*.mp4
*.mov
*.webm
*.mkv
*.wav
*.mp3
