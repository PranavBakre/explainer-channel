          "beats": [
            {
              "id": "S01_01",
              "vo": "A well-run website does not keep a readable copy of your password."
            },
            {
              "id": "S01_02",
              "vo": "So when you log in, what is it checking against?"
            },
            {
              "id": "S01_03",
              "vo": "Somewhere there's a row with your email on it. Next to it sits something nobody at the company can read back."
            },
            {
              "id": "S01_04",
              "vo": "A badly run website does keep the password."
            }
          ],
