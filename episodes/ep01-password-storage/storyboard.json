    {
      "id": "S16",
      "act": 4,
      "title": "The rules changed",
      "transitionIn": "fade",
      "shots": [
        {
          "visual": "TextStack",
          "props": {
            "kicker": "NIST SP 800-63B-4 · July 2025",
            "lines": [
              {
                "text": "The current rules",
                "step": 0
              }
            ]
          },
          "beats": [
            {
              "id": "S16_01",
              "vo": "The current guidelines reflect all of this."
            }
          ]
        },
        {
          "visual": "QuoteCard",
          "props": {
            "quote": "Passwords SHALL be salted and hashed using a suitable password hashing scheme.",
            "highlight": "salted and hashed",
            "source": "NIST SP 800-63B-4 · §3.1.1.2 · July 2025"
          },
          "beats": [
            {
              "id": "S16_02",
              "vo": "The U S standards body Nist now requires salted password hashing in its guidelines, and recommends the highest cost a site can practically handle."
            }
          ]
        },
        {
          "visual": "QuoteCard",
          "props": {
            "quote": "Verifiers and CSPs SHALL NOT require subscribers to change passwords periodically.",
            "highlight": "SHALL NOT",
            "source": "NIST SP 800-63B-4 · §3.1.1.2 · July 2025"
          },
          "beats": [
            {
              "id": "S16_03",
              "vo": "Under these guidelines, sites must not force you to change your password on a schedule, like every ninety days. They must force a change if there's evidence it was compromised."
            }
          ]
        },
        {
          "visual": "QuoteCard",
          "props": {
            "quote": "a minimum of 15 characters in length",
            "highlight": "15 characters",
            "source": "NIST SP 800-63B-4 · §3.1.1.2 · single-factor passwords"
          },
          "beats": [
            {
              "id": "S16_04",
              "vo": "Sites must not demand symbols and mixed case. They ask for length instead. At least fifteen characters, if the password is your only login factor."
            }
          ]
        },
        {
          "visual": "QuoteCard",
          "props": {
            "quote": "SHALL compare the prospective secret against a blocklist that contains known commonly used, expected, or compromised passwords",
            "highlight": "blocklist",
            "source": "NIST SP 800-63B-4 · §3.1.1.2 · July 2025"
          },
          "beats": [
            {
              "id": "S16_05",
              "vo": "And sites must check new passwords against a blocklist of commonly used, expected or compromised passwords."
            }
          ]
        }
      ]
    },
    {
      "id": "S17",
      "act": 4,
      "title": "Checking without telling",
      "transitionIn": "push",
      "shots": [
