    {
      "id": "S10",
      "act": 2,
      "title": "Salt",
      "transitionIn": "zoom",
      "shots": [
        {
          "visual": "TextStack",
          "props": {
            "kicker": "the fix",
            "lines": [
              {
                "text": "Salt",
                "size": 150,
                "tone": "teal",
                "step": 0
              },
              {
                "text": "a random string, unique to each user",
                "serif": false,
                "size": 44,
                "step": 1
              },
              {
                "text": "stored next to the hash · not secret",
                "serif": false,
                "size": 40,
                "tone": "slate",
                "step": 2
              }
            ]
          },
          "beats": [
            {
              "id": "S10_01",
              "vo": "The fix is called salting."
            },
            {
              "id": "S10_02",
              "vo": "Each password gets its own random string, mixed in before hashing. That string is the salt."
            },
            {
              "id": "S10_03",
              "vo": "It isn't secret. It's stored right next to the hash. Its job is to make the same password hash differently for every user."
            }
          ]
        },
        {
          "visual": "SaltGrinder",
          "props": {
            "password": "mango@123",
            "users": [
              {
                "name": "Asha",
                "salt": "9f2c4a71",
                "hash": "fb9d05563ec1fbbdebc0c48ed14a7db7087102a8373e44fc54ad57d8b1ed0401"
              },
              {
                "name": "You",
                "salt": "e05b13d8",
                "hash": "324ce3f954f77c01e68347a9e85134bc81b2455b7a852fa022ea6c4b0efea9a8"
              }
            ],
            "caption": "A table built in advance would need one per salt"
          },
          "beats": [
            {
              "id": "S10_04",
              "vo": "Two people who both chose mango at the rate one two three now get completely different fingerprints."
            },
            {
              "id": "S10_05",
              "vo": "As long as salts are long and random, a table built in advance stops working. It would need a separate table for every salt."
            }
          ]
        }
      ]
    },
    {
      "id": "S11",
      "act": 3,
      "title": "3 · Slow it down",
