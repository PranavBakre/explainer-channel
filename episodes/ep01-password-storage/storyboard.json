        },
        {
          "visual": "TextStack",
          "props": {
            "lines": [
              {
                "text": "A hint is a head start.",
                "step": 0,
                "tone": "red"
              },
              {
                "text": "The site never needs to read it back.",
                "step": 1,
                "size": 56,
                "tone": "amber"
              },
              {
                "text": "It only needs to check it.",
                "step": 1,
                "size": 56,
                "tone": "teal"
              }
            ]
          },
          "beats": [
            {
              "id": "S05_06",
              "vo": "A hint like \"my dog's name\" gives a guesser a head start."
            },
            {
              "id": "S05_07",
              "vo": "So encryption solved the wrong problem. The site never needed to read your password back. It only needs to check it."
            }
          ]
        }
