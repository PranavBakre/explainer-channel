              "sub": "Argon2id + salt"
            },
            {
              "label": "Compare",
              "sub": "then discard",
              "tone": "teal"
            }
          ]
        },
        "beats": [
          {
            "id": "S15_02",
            "vo": "It arrives over an encrypted connection, then gets hashed and compared with the stored value."
          }
        ]
      },
      {
        "visual": "TextStack",
        "props": {
          "kicker": "a warning sign",
          "lines": [
